{
  "name": "tagstash",
  "private": true,
  "version": "1.33.3",
  "type": "module",
  "description": "A tag-based bookmarking web application",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev . --local --port 5000 --proxy 3010",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "setup:db": "wrangler d1 migrations apply tagstash-db --local",
    "build": "vite build && node scripts/prerender-features.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test:auth": "node --test tests/auth-sessions.test.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.10.2",
    "concurrently": "^9.2.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.4.0",
    "playwright-core": "1.63.0",
    "vite": "^6.4.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  }
}
