{
  "name": "Tagstash - Tag-Based Bookmark Manager",
  "short_name": "Tagstash",
  "description": "A tag-based bookmark manager for saving links and organizing bookmarks.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1b1a20",
  "theme_color": "#6d45ff",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
