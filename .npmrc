# Supply-chain install safeguards. See docs/supply-chain.md.
# Settings below are honored by npm >= 11.19; older npm (e.g. the 10.9.2 used by
# Cloudflare Pages) ignores them silently.

# Only resolve versions published more than 7 days ago (applies when npm
# resolves, i.e. install/update/audit fix; `npm ci` follows the lockfile).
min-release-age=7

# Dependency lifecycle scripts must be reviewed in package.json "allowScripts".
# An unreviewed script fails the install instead of just warning.
strict-allow-scripts=true
